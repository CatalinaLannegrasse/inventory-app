<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>

<div class="breadcrumb">
  <a href="/brands">← Back to Brands</a>
</div>

<div class="detail-card form-card">
  <h1>New Brand</h1>
  <p class="muted">Add a hardware manufacturer or vendor.</p>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach((err) => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/brands" method="POST" class="stack-form">
    <div class="form-group">
      <label for="name">Brand Name *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="100"
        value="<%= (formData && formData.name) || '' %>"
        placeholder="e.g., Keychron, Logitech, ASUS"
      />
    </div>

    <div class="form-group">
      <label for="website">Website URL</label>
      <input
        type="url"
        id="website"
        name="website"
        value="<%= (formData && formData.website) || '' %>"
        placeholder="https://example.com"
      />
    </div>

    <div class="action-group">
      <button type="submit" class="btn btn-primary">Create Brand</button>
      <a href="/brands" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

</main>
</body>
</html>