<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>

<div class="breadcrumb">
  <a href="/categories/<%= category.id %>">← Back to <%= category.name %></a>
</div>

<div class="detail-card form-card">
  <h1>Edit Category</h1>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach((err) => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/categories/<%= category.id %>/update" method="POST" class="stack-form">
    <div class="form-group">
      <label for="name">Category Name *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="80"
        value="<%= category.name %>"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3"><%= category.description || '' %></textarea>
    </div>

    <div class="form-group">
      <label for="adminPassword">Admin Password *</label>
      <input
        type="password"
        id="adminPassword"
        name="adminPassword"
        required
        autocomplete="current-password"
        placeholder="Enter admin password to save changes"
      />
    </div>

    <div class="action-group">
      <button type="submit" class="btn btn-primary">Update Category</button>
      <a href="/categories/<%= category.id %>" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

</main>
</body>
</html>