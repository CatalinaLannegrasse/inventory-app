<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>

<div class="breadcrumb">
  <a href="/categories">← Back to Categories</a>
</div>

<div class="detail-card form-card">
  <h1>New Category</h1>
  <p class="muted">Create a department or product group for your tech store.</p>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach((err) => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/categories" method="POST" class="stack-form">
    <div class="form-group">
      <label for="name">Category Name *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        maxlength="80"
        value="<%= (formData && formData.name) || '' %>"
        placeholder="e.g., Keyboards, Monitors, Keycaps"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        rows="3"
        placeholder="Optional notes about items in this category"
      ><%= (formData && formData.description) || '' %></textarea>
    </div>

    <div class="action-group">
      <button type="submit" class="btn btn-primary">Create Category</button>
      <a href="/categories" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

</main>
</body>
</html>