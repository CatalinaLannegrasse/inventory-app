<%- include("../partials/head", { title }) %>
<%- include("../partials/nav") %>

<%
  const selectedCategoryId = String(
    (formData && formData.category_id) || selectedCategory || ""
  );
  const selectedBrandId = String((formData && formData.brand_id) || "");
%>

<div class="breadcrumb">
  <a href="/items">← Back to All Items</a>
</div>

<div class="detail-card form-card">
  <h1>Add Tech Item</h1>
  <p class="muted">Add a new product SKU to your store inventory.</p>

  <% if (errors && errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="error-list">
        <% errors.forEach((err) => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/items" method="POST" class="stack-form">
    <div class="form-row">
      <div class="form-group">
        <label for="sku">SKU *</label>
        <input
          type="text"
          id="sku"
          name="sku"
          required
          maxlength="40"
          value="<%= (formData && formData.sku) || '' %>"
          placeholder="e.g., KB-K2P-001"
        />
      </div>

      <div class="form-group">
        <label for="name">Product Name *</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="150"
          value="<%= (formData && formData.name) || '' %>"
          placeholder="e.g., Keychron K2 Pro"
        />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="category_id">Category *</label>
        <select id="category_id" name="category_id" required>
          <option value="">Select a category...</option>
          <% categories.forEach((cat) => { %>
            <option
              value="<%= cat.id %>"
              <%= selectedCategoryId === String(cat.id) ? "selected" : "" %>
            >
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="brand_id">Brand</label>
        <select id="brand_id" name="brand_id">
          <option value="">None / Unbranded</option>
          <% brands.forEach((brand) => { %>
            <option
              value="<%= brand.id %>"
              <%= selectedBrandId === String(brand.id) ? "selected" : "" %>
            >
              <%= brand.name %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="price">Price (USD) *</label>
        <input
          type="number"
          id="price"
          name="price"
          required
          min="0"
          step="0.01"
          value="<%= (formData && formData.price) || '0.00' %>"
        />
      </div>

      <div class="form-group">
        <label for="quantity">Stock Quantity *</label>
        <input
          type="number"
          id="quantity"
          name="quantity"
          required
          min="0"
          step="1"
          value="<%= (formData && formData.quantity) || '0' %>"
        />
      </div>
    </div>

    <div class="form-group">
      <label for="description">Description & Specs</label>
      <textarea
        id="description"
        name="description"
        rows="3"
        placeholder="Switch type, panel resolution, connectivity, dimensions..."
      ><%= (formData && formData.description) || '' %></textarea>
    </div>

    <div class="action-group">
      <button type="submit" class="btn btn-primary">Save Item</button>
      <a href="/items" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>

</main>
</body>
</html>